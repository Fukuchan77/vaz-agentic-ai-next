{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!packages/schemas/src/generated",
			"!apps/web/src/assets/styles/tailwind.css",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"yaml": {
		"formatter": {
			"enabled": false
		}
	},
	"css": {
		"parser": {
			"cssModules": false
		},
		"linter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/src/assets/styles/tailwind.css"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		}
	]
}
