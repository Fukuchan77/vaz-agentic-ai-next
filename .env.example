# --- AI provider (packages/schemas/src/env.ts) ---
AI_PROVIDER=anthropic
# 省略時は claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=anthropic のとき必須
ANTHROPIC_API_KEY=
# 省略時は gpt-6-sol
OPENAI_MODEL=gpt-6-sol
# AI_PROVIDER=openai のとき必須
OPENAI_API_KEY=
# 省略時は http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# 省略時は granite4.2:latest（汎用・agent/tool 向け）
# 軽量運用: granite4.2:3b / gemma4:e2b
# 品質優先の代替: gemma4:e4b
OLLAMA_MODEL=granite4.2:latest

# --- Embedding (packages/schemas/src/env.ts) ---
# 省略時は ollama
AI_EMBEDDING_PROVIDER=ollama
# 省略時は nomic-embed-text
AI_EMBEDDING_MODEL=nomic-embed-text

# --- Chat runtime (packages/schemas/src/env.ts) ---
# 省略時は 200000
CHAT_TOKEN_BUDGET=200000
# 省略時は 200000
JOB_TOKEN_BUDGET=200000

# --- Tool approvals (packages/agents/src/chat-agent.ts) ---
# 未設定だと HITL 承認 ID の偽造・再利用を防げない（チャットはステートレスなため、
# クライアントが送り返す approval.id をそのまま信用してしまう）。
# openssl rand -base64 32 等で生成し、インスタンスが複数ある場合は全インスタンスで
# 同じ値を共有すること。
TOOL_APPROVAL_SECRET=

# --- Auth (packages/schemas/src/auth-env.ts, apps/web/src/lib/auth.ts) ---
# entra-id または google-workspace。省略時は entra-id
AUTH_IDP=entra-id
# Auth.js のセッション暗号化に必須
AUTH_SECRET=
# AUTH_IDP=entra-id のとき必須
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# AUTH_IDP=google-workspace のとき必須
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Infra (packages/schemas/src/infra-env.ts) ---
# ホスト上の Next.js / CLI 用。Compose 内部では docker-compose.yml が db:5432 を注入する。
DATABASE_URL=postgres://vaz:vaz@localhost:5432/vaz
# ホスト上のクライアント用。Compose 内部では redis://redis:6379 を注入する。
REDIS_URL=redis://localhost:6379

# --- Inngest (docker-compose.yml が既定値を提供) ---
# ホスト上のクライアント用。Compose worker には http://engine:8288 を注入する。
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# dev モードでは 1
INNGEST_DEV=1

# --- Telemetry (packages/config、任意) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 実際の span export は Web の registerOTel() が読む OTLP exporter 設定で決まる。
# 鍵だけ設定してエンドポイントが無い場合、initTelemetry が one-shot warning を出す。
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# --- Worker (apps/worker、任意) ---
WORKER_INSTANCE_ID=

# --- RAG sidecar (packages/rag/bin/ingest.ts、--via-parser 使用時は必須・fail-fast) ---
AGENT_SERVICE_URL=http://localhost:8000

# --- Evals (packages/evals、任意) ---
EVAL_NIGHTLY_COST_CAP_TOKENS=
PR_GATE_BASELINE_PATH=
PR_GATE_OUTPUT_PATH=
